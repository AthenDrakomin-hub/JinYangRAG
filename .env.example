# AGNES_API_KEY: Required for Agnes AI API calls.
# Set this to your Agnes AI API key for both chat and embeddings.
AGNES_API_KEY="MY_AGNES_API_KEY"

# Optional override for Agnes API base URL.
# Default is the official Agnes AI compatible endpoint.
AGNES_API_BASE_URL="https://apihub.agnes-ai.com/v1"

# Optional model configuration.
# Available examples:
#   agnes-1.5-flash
#   agnes-2.0-flash
#   agnes-image-2.0-flash
#   agnes-image-2.1-flash
#   agnes-video-v2.0
# If your Agnes API supports a dedicated embedding model name, fill it here.
# Otherwise you can use a compatible text model name such as agnes-2.0-flash.
AGNES_EMBEDDING_MODEL="agnes-2.0-flash"
AGNES_CHAT_MODEL="agnes-2.0-flash"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase vector database credentials
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_KEY="MY_SUPABASE_KEY"

